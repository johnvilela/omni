# omni docker settings — copy to .env next to docker-compose.yml.
# compose reads it for ${…} substitution and passes every line into the container.

# Telegram bot token from @BotFather. The container connects on start when set;
# otherwise run: docker exec -it omni omni channels connect -c telegram
TELEGRAM_BOT_TOKEN=

# Chat mode via API keys (optional). Agent mode needs a cli login instead — the
# installer shares the logins already on this PC; for a cli installed inside:
# docker exec -it omni claude login   (codex login --device-auth, gemini)
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=

# Vendor clis npm-installed inside the container (comma-separated). The
# installer narrows this to what your PC lacks and mounts the rest read-only.
OMNI_VENDOR_INSTALL=claude,codex,gemini

# Plugins (owner/repo, comma-separated) installed or upgraded in the background at every start
#OMNI_PLUGINS=

# Scheduled tasks (/crons) run in this timezone
TZ=UTC

# Image tag: a release like v0.28.0, or latest
OMNI_VERSION=latest
# Host port on 127.0.0.1 (change when a native omni-server already owns 8787)
#OMNI_PORT=8787
# Guardian check interval (the systemd timer's 2min); off disables
#OMNI_GUARDIAN_INTERVAL=2m
# Container user — the installer sets these from `id -u` / `id -g`
#OMNI_UID=1000
#OMNI_GID=1000
